# ============================================================
# 上游（第三方 Anthropic 端点）配置 —— 只改这一个文件
# ============================================================

# 1. 上游地址，http 或 https 均可。
#    两种写法都支持，脚本会自动处理：
#      https://your-host.com        （脚本会拼 /v1/messages）
#      https://your-host.com/v1     （脚本会拼 /messages）
#      http://192.0.2.10:8080
#    注意：结尾不要带斜杠，也不要写死 /v1/messages
UPSTREAM_BASE_URL=https://your-host.com

# 2. 你的令牌（Anthropic 协议下会作为 x-api-key 请求头发出）
#    也可以不写在这里，改用环境变量 ANTHROPIC_AUTH_TOKEN 或 ANTHROPIC_API_KEY。
#    查找顺序：本文件 → ANTHROPIC_AUTH_TOKEN → ANTHROPIC_API_KEY，
#    找到一个就不再往下找。启动时终端会打印实际使用的来源。
#    注意：某些工具会把上述变量写成占位值（如 CC Switch 设为 PROXY_MANAGED），
#          那本身不是可用令牌，遇到这种情况直接填本行即可。
UPSTREAM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# 3. 上游真实模型名，多个用英文逗号分隔。
#    不确定的话，先填一个最常见的 Claude 名，跑 detect_models.py 自动探测。
UPSTREAM_MODELS=claude-sonnet-4-5-20250929

# 4. 对外暴露的模型别名（可选）。
#    留空 = 与上游同名。填写后数量必须与 UPSTREAM_MODELS 一致，逗号分隔。
#    用途：某些客户端写死了 OpenAI 模型名，可以在这里做映射。
PROXY_MODEL_ALIASES=

# ============================================================
# 本地代理配置
# ============================================================

# 本地监听端口，对外暴露的就是 http://127.0.0.1:4000
PROXY_PORT=4000

# 本地代理自己的访问密钥。客户端填这个，不是填你的上游 token。
# 留空 = 首次启动自动生成随机密钥并写回本文件（推荐）。
# 换成足够随机的值。若把代理开放到局域网（0.0.0.0），必须自设强随机值。
PROXY_MASTER_KEY=

# max_tokens 相关说明：
# 客户端不传 max_tokens 时，LiteLLM 会按内置模型表补该模型的上限值
# （例如 claude-sonnet-4-5 系列记为 64000）。若你的第三方中转限制更小而报错，
# 在客户端显式传一个较小的 max_tokens 即可，不必改这里。
# 本值只在模型不在 LiteLLM 内置表时作为兜底。
DEFAULT_MAX_TOKENS=8192

# 允许客户端使用 UPSTREAM_MODELS 之外的模型名并原样转发，减少报错
ALLOW_ANY_MODEL=true

# 请求超时（秒）。长思考 / 长输出建议调大到 900
REQUEST_TIMEOUT=600

# 请求纠偏开关。转发前注入工具使用规范 + 抬升输出 token 下限，
# 用于抑制模型虚构工具（如伪造 webReader）与思考块耗尽正文导致的截断。
# 想看未加固的原始行为时改成 false。
GUARD_ENABLED=true

# 输出 token 下限。部分模型会先输出思考块，给太小正文会被吞掉。
# 注意：开启 THINKING_ENABLED 时必须大于 THINKING_BUDGET_TOKENS，
# 否则 gen_config.py 会直接报错（Anthropic 要求 max_tokens 严格大于思考预算）。
MIN_OUTPUT_TOKENS=1600

# 按模型的输出上限表（JSON 对象）：max_tokens 超过上游上限会整轮 400 而非截断，
# 代理按此表夹紧。留空则只用 bridge_guard.py 内置的实测表；
# 新模型实测出上限后填这里，例如 {"glm-5.3": 131072, "MiniMax-M3": 524288}
#MAX_OUTPUT_TOKEN_CAPS=

# 私有 CA 证书文件（PEM 路径）。仅自建中转用私有 CA 签发证书时需要；
# 留空则用系统信任库。探测脚本与代理都会读它。
# 遇到 CERTIFICATE_VERIFY_FAILED 时优先走这条路，不要图省事关掉校验。
#UPSTREAM_CA_BUNDLE=

# 完整请求转储开关。默认关闭：常规日志只记消息条数、工具名、耗时等运维元数据，
# 不落完整对话。只有复现具体工具/schema 问题时才临时设为 true。
# 开启后写入 logs/last_request.json（单文件覆盖、敏感键打码、图片 base64 折叠、
# 超 BRIDGE_DUMP_MAX_CHARS 截断、权限 0600）。
# 排查完请改回 false 并删除该文件——它含 system 全文与用户对话。
# 写在这里即可生效：启动脚本（前台/后台共用 boot_common.prepare）会把解析后的值
# 导出给 LiteLLM 子进程。系统环境变量优先于本文件，便于临时覆盖。
# 上限必须是正整数；写成 0 / 负数 / 非数字会打印提示并按默认 200000 处理。
#BRIDGE_DUMP_ENABLED=false
#BRIDGE_DUMP_MAX_CHARS=200000
# 转储目标文件，默认 logs/last_request.json（相对启动目录）
#BRIDGE_DUMP_FILE=logs/last_request.json

# 是否开启 extended thinking。
# 第三方中转大多不支持该字段，开启后若上游报错请改回 false。
THINKING_ENABLED=false
THINKING_BUDGET_TOKENS=2000

# 需要额外附加的请求头（JSON 字符串），一般留空。
# 例：{"anthropic-dangerous-direct-browser-access":"true","X-Custom":"abc"}
EXTRA_HEADERS=

# 是否让部分第三方网关走兼容 Anthropic 的 OpenAI 模式（极少用），true/false
# 若你的地址本质是 OpenAI 协议而非 Anthropic 协议，改这里即可，无需换方案。
UPSTREAM_IS_OPENAI_NATIVE=false

# 仅 UPSTREAM_IS_OPENAI_NATIVE=true 时生效：OpenAI 路由的完整地址。
# 留空则自动在 UPSTREAM_BASE_URL 后补 /v1（LiteLLM 直接拼 /chat/completions，
# 绝大多数网关只认 /v1/chat/completions，已实测）。
# 网关把 OpenAI 路由挂在非标准路径（如 /api/openai/v1）时必须手填。
#UPSTREAM_BASE_URL_OPENAI=
